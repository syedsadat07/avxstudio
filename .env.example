# ─────────────────────────────────────────────────────────────
# AURAVIX Bath Studio — Environment Variables
# ─────────────────────────────────────────────────────────────
# Copy this file to ".env" and fill in your actual values.
# NEVER commit the real .env file — it contains secrets.
# ─────────────────────────────────────────────────────────────

# Database (SQLite — local file path)
DATABASE_URL=file:./db/custom.db

# Supabase (Backend for bookings & contact messages)
# Get these from: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# JWT Secret (for admin/customer authentication)
# Generate a random string: openssl rand -base64 32
JWT_SECRET=your-jwt-secret-key-change-this

# ─── Optional: Server-side Supabase (with service role key) ───
# Only needed if you want to bypass Row Level Security
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
