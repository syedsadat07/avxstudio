generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  phone     String?
  password  String?
  role      String   @default("customer") // "customer" | "admin"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Lead {
  id          String   @id @default(cuid())
  name        String
  email       String
  phone       String?
  city        String?
  source      String   @default("website")
  status      String   @default("new")
  message     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Booking {
  id            String   @id @default(cuid())
  name          String
  email         String
  phone         String
  city          String
  preferredDate String
  preferredTime String
  requirements  String?
  status        String   @default("pending")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Quotation {
  id           String   @id @default(cuid())
  name         String
  email        String
  phone        String?
  bathroomSize String
  materialType String
  tileSelection String?
  vanityType   String?
  accessories   String?
  estimatedCost Float
  timeline     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model AdminQuotation {
  id            String   @id @default(cuid())
  customerName  String
  customerEmail String
  customerPhone String?
  bathroomSize  String
  packageTier   String
  estimatedCost Float
  timeline      String?
  status        String   @default("draft") // draft | sent | accepted | rejected
  notes         String?
  createdById   String?  // the admin user who created it
  createdByName String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Design {
  id          String   @id @default(cuid())
  title       String
  category    String
  style       String
  imageUrl    String
  description String?
  budget      String?
  size        String?
  featured    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Package {
  id          String   @id @default(cuid())
  name        String
  tier        String
  price       Float
  description String
  features    String
  imageUrl    String?
  popular     Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model BlogPost {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  excerpt     String?
  content     String
  category    String
  imageUrl    String?
  published   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Testimonial {
  id          String   @id @default(cuid())
  name        String
  location    String?
  rating      Int
  review      String
  imageUrl    String?
  featured    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model RenovationProject {
  id          String   @id @default(cuid())
  userId      String?
  status      String   @default("consultation")
  packageTier String?
  totalCost   Float?
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String?
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
